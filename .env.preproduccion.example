# Variables de entorno INDEPENDIENTES para el ambiente de pruebas/preproducción.
# Se copia a .env en el servidor; nunca se versiona el .env real.

APP_NAME="Laravel Preproduccion"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=http://preproduccion.local

LOG_CHANNEL=stack
LOG_LEVEL=info

# Base de datos de pruebas (SQLite para el runner / máquina de pruebas).
# En un servidor real se puede usar MySQL: descomentar y completar fuera del repositorio.
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel_preprod
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
